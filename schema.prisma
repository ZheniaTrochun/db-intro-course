generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model brand {
  brand_id    Int       @id @default(autoincrement())
  brand_title String    @unique @db.VarChar(100)
  brand_country	String?
  product     product[]
  supplier_id   Int
  supplier      supplier  @relation(fields: [supplier_id], references: [supplier_id], onDelete: NoAction)
}

model category {
  category_id      Int                @id @default(autoincrement())
  category_title   String             @unique @db.VarChar(100)
  product_category product_category[]
}

model customer {
  customer_id           Int      @id @default(autoincrement())
  customer_first_name   String   @db.VarChar(100)
  customer_last_name    String   @db.VarChar(100)
  customer_email        String   @unique @db.VarChar(100)
  customer_phone_number String   @unique @db.VarChar(100)
  customer_birth_date   DateTime @db.Date
  orders                orders[]
  bonuses				Int?	 @default(0)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_item {
  orders_id  Int
  product_id Int
  quantity   Int
  price      Decimal @db.Decimal(8, 2)
  orders     orders  @relation(fields: [orders_id], references: [orders_id], onDelete: NoAction, onUpdate: NoAction)
  product    product @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([orders_id, product_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  orders_id               Int               @id @default(autoincrement())
  customer_id             Int?
  orders_date             DateTime          @default(now()) @db.Timestamp(6)
  orders_price            Decimal           @db.Decimal(8, 2)
  orders_status           order_status_type
  orders_delivery_address String
  order_item              order_item[]
  customer                customer?         @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product {
  product_id                 Int                @id @default(autoincrement())
  brand_id                   Int
  product_title              String             @db.VarChar(100)
  product_price              Decimal            @db.Decimal(8, 2)
  product_expiration_date    DateTime?          @db.Date
  product_volume             String             @db.VarChar(50)
  product_application_method String?
  order_item                 order_item[]
  brand                      brand              @relation(fields: [brand_id], references: [brand_id], onDelete: NoAction, onUpdate: NoAction)
  product_category           product_category[]
  review                     review[]
  inStock                    Boolean            @default(true)
}

model product_category {
  product_id  Int
  category_id Int
  category    category @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  product     product  @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([product_id, category_id])
}

enum order_status_type {
  New
  In_Progress @map("In Progress")
  Shipped
  Delivered
  Cancelled
}

model review {
  id        Int     @id @default(autoincrement())
  rating    Int
  comment   String?
  product   product @relation(fields: [productId], references: [product_id])
  productId Int
}

model supplier {
  supplier_id		    Int		@id @default(autoincrement())
  name	        String  @db.VarChar(100)
  phone_number	String  @unique @db.VarChar(100)
  email	        String  @unique @db.VarChar(100)
  brand         brand[]
}