erDiagram
    User ||--o{ Video : "uploads"
    User ||--o{ Comment : "writes"
    Video ||--o{ Comment : "has"
    User ||--o{ Like : "gives"
    Video ||--o{ Like : "receives"
    User ||--o{ Subscription : "subscriber"
    User ||--o{ Subscription : "channel"

    User {
        UUID id PK
        VARCHAR email UK
        VARCHAR username UK
        VARCHAR password "nullable, CHECK: pass OR google"
        VARCHAR google_id "unique, nullable"
        VARCHAR avatar "nullable"
        VARCHAR banner "nullable"
        TEXT description "nullable"
        TIMESTAMPTZ created_at
    }

    Video {
        UUID id PK
        VARCHAR title
        TEXT description "nullable"
        VARCHAR url
        VARCHAR thumbnail "nullable"
        INTEGER views "default 0, CHECK >= 0"
        TIMESTAMPTZ created_at
        UUID author_id FK
    }

    Comment {
        UUID id PK
        TEXT text
        TIMESTAMPTZ created_at
        UUID user_id FK
        UUID video_id FK
    }

    Like {
        UUID user_id PK, FK
        UUID video_id PK, FK
        TIMESTAMPTZ created_at
    }

    Subscription {
        UUID subscriber_id PK, FK
        UUID channel_id PK, FK
        TIMESTAMPTZ created_at
    }
