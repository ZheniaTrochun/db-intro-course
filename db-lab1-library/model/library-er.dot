graph Library {
graph [rankdir=TB, bgcolor="white", pad=0.4, nodesep=0.9, ranksep=1.1, splines=line, fontname="Arial", fontsize=20, labelloc=t, label="Бібліотека - ER-модель"];
node [shape=plain, fontname="Arial", fontsize=13];
edge [fontname="Arial", fontsize=12, color="#52677d", penwidth=1.4, labeldistance=3.2, labelangle=50];
author [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9eafbf"><TR><TD COLSPAN="3" BGCOLOR="#dce9f3"><B>Автор</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">author_id</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">ціле</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">given_name?</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">текст</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">family_name?</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">текст</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">pen_name?</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">текст</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"></TD></TR></TABLE>>];
authorship [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9eafbf"><TR><TD COLSPAN="3" BGCOLOR="#dce9f3"><B>Авторство</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">author_id</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">ціле</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">PK, FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">edition_id</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">ціле</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">PK, FK</TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="11">PK = (author_id, edition_id)</FONT></TD></TR></TABLE>>];
edition [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9eafbf"><TR><TD COLSPAN="3" BGCOLOR="#dce9f3"><B>Видання</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">edition_id</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">ціле</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">title</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">текст</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">language</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">текст</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">publication_year?</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">ціле</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">publisher_name?</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">текст</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8"></TD></TR></TABLE>>];
copy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9eafbf"><TR><TD COLSPAN="3" BGCOLOR="#dce9f3"><B>Примірник</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">inventory_number</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">ціле</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">edition_id</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">ціле</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">FK</TD></TR></TABLE>>];
reader [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9eafbf"><TR><TD COLSPAN="3" BGCOLOR="#dce9f3"><B>Читач</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">reader_id</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">ціле</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">given_name</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">текст</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">family_name</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">текст</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">phone</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">текст</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"></TD></TR></TABLE>>];
loan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9eafbf"><TR><TD COLSPAN="3" BGCOLOR="#dce9f3"><B>Видача</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">loan_id</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">ціле</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">reader_id</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">ціле</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">inventory_number</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">ціле</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">issued_on</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">дата</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">due_on</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8">дата</TD><TD ALIGN="LEFT" BGCOLOR="#f1f5f8"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">returned_on?</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">дата</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"></TD></TR></TABLE>>];
{rank=same; author; edition;}
{rank=same; authorship; copy; reader;}
author -- authorship [taillabel="1", headlabel="1..N", label="має авторство"];
edition -- authorship [taillabel="1", headlabel="0..N", label="має авторів"];
edition -- copy [taillabel="1", headlabel="1..N", label="має примірники"];
copy -- loan [taillabel="1", headlabel="0..N", label="фігурує у видачах"];
reader -- loan [taillabel="1", headlabel="0..N", label="отримує"];
}
