erDiagram
    Customer ||--o{ Rental : "has"
    Car ||--o{ Rental : "is rented in"
    CarModel ||--o{ Car : "defines"
    Rental ||--o{ Payment : "has"

    Customer {
        string id PK
        string firstName
        string lastName
        string email
        string phone
        string address
    }

    Rental {
        string id PK
        string customerId FK
        string carId FK
        datetime startDate
        datetime endDate
        number price
        string status
    }

    Car {
        string id PK
        string modelId FK
        string status
    }

    CarModel {
        string id PK
        string brand
        string model
        string category
        string description
        number dailyRate
    }

    Payment {
        string id PK
        string rentalId FK
        number amount
        datetime paymentDate
        string status
    }