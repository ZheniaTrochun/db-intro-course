    PRODUCT ||--o{ MOVEMENT_ITEM : includes

    CATEGORY {
        int category_id PK
        string name
    }

    PRODUCT {
        int product_id PK
        int category_id FK
        string sku UK
        string name
        string unit
    }

    WAREHOUSE {
        int warehouse_id PK
        string name
        string address
    }

    SUPPLIER {
        int supplier_id PK
        string name
        string phone
        string email
    }

    MOVEMENT {
        int movement_id PK
        int warehouse_id FK
