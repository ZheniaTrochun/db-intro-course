---
config:
  layout: elk
  elk:
    mergeEdges: false
    nodePlacementStrategy: NETWORK_SIMPLEX
---
erDiagram
    direction TB

    STUDENT ||--o{ VISIT : "здійснює"
    VISIT ||--o{ INCIDENT : "пов'язаний з"
    VISIT ||--o{ INCIDENT_PARTICIPANT : "бере участь"
    INCIDENT ||--o{ INCIDENT_PARTICIPANT : "має учасників"
    SECURITY_EMPLOYEE ||--o{ INCIDENT : "фіксує"
    INCIDENT_TYPE ||--o{ INCIDENT : "визначає тип"
    INCIDENT_STATUS ||--o{ INCIDENT : "визначає статус"
    PARTICIPANT_ROLE ||--o{ INCIDENT_PARTICIPANT : "визначає роль"

    STUDENT {
        int student_id PK
        int group_id
        int faculty_id
        string full_name
    }

    SECURITY_EMPLOYEE {
        int employee_id PK
        string full_name
        string position
        string phone UK
    }

    INCIDENT_TYPE {
        int type_id PK
        string name UK
    }

    INCIDENT_STATUS {
        int status_id PK
        string name UK "Новий / У процесі / Опрацьовано"
    }

    PARTICIPANT_ROLE {
        int role_id PK
        string name UK "Порушник / Постраждалий / Свідок"
    }

    VISIT {
        int visit_id PK
        int student_id FK
        string category "default Відпочинок"
        datetime started_at "default now"
        datetime ended_at "nullable, >= started_at"
    }

    INCIDENT {
        int incident_id PK
        int visit_id FK
        int type_id FK
        int employee_id FK
        int status_id FK "default 1"
        string description "nullable"
        datetime occurred_at
        string severity "Низький / Середній / Високий"
    }

    INCIDENT_PARTICIPANT {
        int incident_id PK, FK
        int visit_id PK, FK
        int role_id FK
    }