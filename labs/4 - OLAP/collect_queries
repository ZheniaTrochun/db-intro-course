#!/usr/bin/env bash

DIRNAME="$(dirname "$0")"
MDFILE="$DIRNAME/report.md"

CONTENT=$(cat "$MDFILE")

echo "$CONTENT" | awk '/^```[sS][qQ][lL]/ { print ""; flag=1; next } /```/ { if (flag) { flag=0; print ""; next } } flag; /^# / { sub(/^#+/, "---"); print toupper($0) }; /^## / { sub(/^#+/, "---"); print }';
