/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model player {
  player_id               Int                       @id @default(autoincrement())
  person_id               Int                       @unique
  rating                  Int?
  sports_title            sports_title              @default(NONE)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  match_participant       match_participant[]
  users                   users                     @relation(fields: [person_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  team                    team[]
  team_member             team_member[]
  tournament_registration tournament_registration[]
}
