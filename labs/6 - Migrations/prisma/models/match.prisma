/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model match {
  match_id           Int                @id @default(autoincrement())
  tournament_id      Int
  table_id           Int?
  stage              match_stage
  race_to_frames     Int?               @db.SmallInt
  race_to_points     Int?               @db.SmallInt
  time_limit_minutes Int?               @db.SmallInt
  match_status       match_status       @default(SCHEDULED)
  scheduled_at       DateTime?          @db.Timestamptz(6)
  started_at         DateTime?          @db.Timestamptz(6)
  finished_at        DateTime?          @db.Timestamptz(6)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  billiard_table     billiard_table?    @relation(fields: [table_id], references: [table_id], onUpdate: NoAction)
  tournament         tournament         @relation(fields: [tournament_id], references: [tournament_id], onDelete: Cascade, onUpdate: NoAction)
  match_participant  match_participant[]

  @@index([table_id], map: "idx_match_table_id")
  @@index([tournament_id], map: "idx_match_tournament_id")
}
