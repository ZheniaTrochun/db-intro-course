/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tournament_registration {
  tournament_registration_id Int            @id @default(autoincrement())
  tournament_id              Int
  player_id                  Int?
  team_id                    Int?
  seed_number                Int?           @db.SmallInt
  payment_status             payment_status @default(PENDING)
  final_placement            Int?           @db.SmallInt
  prize_won                  Decimal        @default(0.00) @db.Decimal(10, 2)
  registered_at              DateTime       @default(now()) @db.Timestamptz(6)
  player                     player?        @relation(fields: [player_id], references: [player_id], onDelete: Restrict, onUpdate: NoAction)
  team                       team?          @relation(fields: [team_id], references: [team_id], onDelete: Restrict, onUpdate: NoAction)
  tournament                 tournament     @relation(fields: [tournament_id], references: [tournament_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tournament_id, player_id], map: "uq_registration_tournament_player")
  @@unique([tournament_id, seed_number], map: "uq_registration_tournament_seed")
  @@unique([tournament_id, team_id], map: "uq_registration_tournament_team")
  @@index([player_id], map: "idx_tournament_registration_player_id")
  @@index([team_id], map: "idx_tournament_registration_team_id")
  @@index([tournament_id], map: "idx_tournament_registration_tournament_id")
}
