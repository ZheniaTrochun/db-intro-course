/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model team {
  team_id                 Int                       @id @default(autoincrement())
  team_name               String                    @unique(map: "uq_team_name") @db.VarChar(100)
  captain_id              Int
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  match_participant       match_participant[]
  player                  player                    @relation(fields: [captain_id], references: [player_id], onUpdate: NoAction)
  team_member             team_member[]
  tournament_registration tournament_registration[]

  @@index([captain_id], map: "idx_team_captain_id")
}
