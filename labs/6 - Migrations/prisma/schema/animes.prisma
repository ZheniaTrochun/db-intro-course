enum MpaaRating {
  g
  pg
  pg13
  r
  nc17
}

enum AnimeStatus {
  upcoming
  ongoing
  finished
}

enum AnimeFormat {
  tv
  ova
  ona
  movie
  special
  music
  other
}

model Animes {
  animeId              String        @id @default(uuid())
  slug                 String        @unique
  titleUa              String
  titleEn              String
  titleOriginal        String
  animeDescription     String        @default("")
  coverUrl             String?
  productionStudio     String?
  malId                String?
  anilistId            String?
  hikkaId              String?
  imdbId               String?
  yearReleased         Int?
  avgEpisodeDuration   Int
  episodeCount         Int
  ageRestriction        MpaaRating? 
  animeStatus          AnimeStatus? 
  animeFormat          AnimeFormat   @default(tv)
  available            Boolean       @default(true)

  @@index([available], name: "idx_anime_available")
  @@map("animes")
}