  }

  upcomingEpisodes {
    UUID anime_id "PK FK"
    TEXT episode_name "PK" 
    TIMESTAMP episode_date ""
  }
  
  rooms_REDIS_ {
    TEXT room_code "PK"
    UUID owner_id "FK"
    UUID[] participants ""
    BIGINT[] playlist ""
    TIMESTAMP play_timestamp ""
    INTEGER play_offset ""
    BOOLEAN playing ""
    BOOLEAN public ""
  }

  sessions {
    BIGSERIAL session_id "PK"
    UUID user_id "FK"
    TEXT external_refresh_token ""
    TEXT internal_refresh_token "UK"
    ENUM auth_provider "google/facebook etc."
    TEXT device_type ""
    TEXT device_name ""
    TEXT os ""
    TEXT browser ""
    TEXT user_agent ""
    INET ip_adress ""
    TEXT location ""
  }

  users ||--O{ comments : "writes"
