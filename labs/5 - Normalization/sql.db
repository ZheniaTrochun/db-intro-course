---------------------------------------------------------------------
-- ПЕРЕВІРКА РОБОТИ ТА ОБЧИСЛЕННЯ КОМІСІЇ (VIEW)
---------------------------------------------------------------------

-- Створюємо представлення (VIEW) для зручного перегляду договорів із порахованою комісією
CREATE OR REPLACE VIEW v_lease_details AS
SELECT 
    la.lease_id,
    c.city_name || ', ' || p.street || ', буд. ' || p.building_number || COALESCE(', кв. ' || p.apartment_number, '') AS full_address,
    t.last_name || ' ' || t.first_name AS tenant_name,
    r.last_name || ' ' || r.first_name AS realtor_name,
    la.start_date,
    la.end_date,
    la.rental_amount,
    ROUND(la.rental_amount * r.commission_rate / 100.0, 2) AS calculated_commission
FROM lease_agreement la
JOIN property p ON la.property_id = p.property_id
JOIN city c ON p.city_id = c.city_id
JOIN tenant t ON la.tenant_id = t.tenant_id
LEFT JOIN realtor r ON la.realtor_id = r.realtor_id;

-- Перевіряємо результат
SELECT * FROM v_lease_details;



