DROP TABLE IF EXISTS lease_agreement,
application,
application_status,
property,
city,
property_owner,
tenant,
realtor CASCADE;

CREATE TABLE city (
    city_id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    city_name VARCHAR(50) NOT NULL UNIQUE
);

CREATE TABLE property_owner (
    owner_id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    last_name VARCHAR(40) NOT NULL,
    first_name VARCHAR(40) NOT NULL,
    middle_name VARCHAR(40),
    phone_number VARCHAR(20) NOT NULL UNIQUE,
    passport_data VARCHAR(20) NOT NULL UNIQUE
);

CREATE TABLE property (
    property_id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    owner_id INT NOT NULL REFERENCES property_owner(owner_id),
    city_id INT NOT NULL REFERENCES city(city_id),
    street VARCHAR(80) NOT NULL,
    building_number VARCHAR(15) NOT NULL,
    apartment_number VARCHAR(15),
    UNIQUE (city_id, street, building_number, apartment_number)
);

CREATE TABLE tenant (
    tenant_id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    last_name VARCHAR(40) NOT NULL,
    first_name VARCHAR(40) NOT NULL,
    middle_name VARCHAR(40),
    phone_number VARCHAR(20) NOT NULL UNIQUE
);


    realtor_id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    last_name VARCHAR(40) NOT NULL,
    first_name VARCHAR(40) NOT NULL,
    middle_name VARCHAR(40),
    phone_number VARCHAR(20) NOT NULL UNIQUE,
    commission_rate DECIMAL(4, 2) NOT NULL CHECK (commission_rate >= 0)
);


CREATE TABLE application_status (
    status_id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    status_name VARCHAR(20) NOT NULL UNIQUE
);


CREATE TABLE application (
    application_id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    tenant_id INT NOT NULL REFERENCES tenant(tenant_id),
    property_id INT NOT NULL REFERENCES property(property_id),
    submission_date DATE NOT NULL,
    status_id INT NOT NULL REFERENCES application_status(status_id)
);

CREATE TABLE lease_agreement (
    lease_id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    property_id INT NOT NULL REFERENCES property(property_id),
    tenant_id INT NOT NULL REFERENCES tenant(tenant_id),
    realtor_id INT REFERENCES realtor(realtor_id),
    start_date DATE NOT NULL,
    end_date DATE NOT NULL CHECK (end_date > start_date),
    rental_amount DECIMAL(12, 2) NOT NULL CHECK (rental_amount > 0)
);

