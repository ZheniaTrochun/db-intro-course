DROP VIEW IF EXISTS v_lease_details;
DROP TABLE IF EXISTS
    new_lease_agreement,
    new_application,
    new_application_status,
    new_property,
    new_city,
    new_property_owner,
    new_tenant,
    new_realtor,
    lease_agreement,
    application,
    application_status,
    property,
    city,
    property_owner,
    tenant,
    realtor
CASCADE;

---------------------------------------------------------------------
-- попередній варіант таблиці з lab2 доданий для демонстрації виконання коду
---------------------------------------------------------------------

CREATE TABLE PROPERTY_OWNER (
    owner_id INT generated always as identity PRIMARY KEY,
    full_name VARCHAR(100) not null unique,
    phone_number VARCHAR(20) not null unique,
    passport_data VARCHAR(20) not null unique
);

CREATE TABLE PROPERTY (
    property_id INT generated always as identity PRIMARY KEY,
    owner_id INT not null,
    adress VARCHAR(80) not null unique,
    FOREIGN KEY (owner_id) REFERENCES PROPERTY_OWNER(owner_id)
);

CREATE TABLE TENANT (
    tenant_id INT generated always as identity PRIMARY KEY,
    full_name VARCHAR(100) not null,
    phone_number VARCHAR(20) not null unique
);

CREATE TABLE REALTOR (
    realtor_id INT generated always as identity PRIMARY KEY,
    full_name VARCHAR(100) not null,
    phone_number VARCHAR(20) not null unique,
    commission_rate DECIMAL(4, 2) not null CHECK (commission_rate >= 0)
);

CREATE TABLE APPLICATION (
    application_id INT generated always as identity PRIMARY KEY,
    tenant_id INT not null,
    property_id INT not null,
    submission_date DATE not null,
    status VARCHAR(20) not null CHECK (status IN ('в обробці', 'схвалено', 'відхилено')),
    FOREIGN KEY (tenant_id) REFERENCES TENANT(tenant_id),
    FOREIGN KEY (property_id) REFERENCES PROPERTY(property_id)
);

CREATE TABLE LEASE_AGREEMENT (
    lease_id INT generated always as identity PRIMARY KEY,
    property_id INT not null,
    tenant_id INT not null,
    realtor_id INT,
    start_date DATE not null,
    end_date DATE not null CHECK (end_date > start_date),
    rental_amount DECIMAL(12, 2) not null CHECK (rental_amount > 0),
    agency_commission DECIMAL(12, 2) CHECK (agency_commission >= 0),
    FOREIGN KEY (property_id) REFERENCES PROPERTY(property_id),
    FOREIGN KEY (tenant_id) REFERENCES TENANT(tenant_id),
    FOREIGN KEY (realtor_id) REFERENCES REALTOR(realtor_id),
    constraint ch_ex_rieltor check(
        (
            realtor_id is not null
            and agency_commission is not null
        )
        or (
            realtor_id is null
            and agency_commission is null
        )
    )
);

