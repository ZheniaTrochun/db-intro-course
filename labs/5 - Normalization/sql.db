---------------------------------------------------------------------
-- частина коду що відповідає лабораторній
---------------------------------------------------------------------
BEGIN;

-- 1. Створюємо нові довідники
CREATE TABLE city (
    city_id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    city_name VARCHAR(50) NOT NULL UNIQUE
);

CREATE TABLE application_status (
    status_id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    status_name VARCHAR(20) NOT NULL UNIQUE
);

INSERT INTO application_status (status_name)
VALUES ('в обробці'), ('схвалено'), ('відхилено');

-- 2. Змінюємо PROPERTY_OWNER -> new_property_owner
ALTER TABLE PROPERTY_OWNER
    ADD COLUMN last_name VARCHAR(40),
    ADD COLUMN first_name VARCHAR(40),
    ADD COLUMN middle_name VARCHAR(40);

UPDATE PROPERTY_OWNER
SET
    last_name = split_part(trim(full_name), ' ', 1),
    first_name = split_part(trim(full_name), ' ', 2),
    middle_name = split_part(trim(full_name), ' ', 3);

ALTER TABLE PROPERTY_OWNER
    ALTER COLUMN last_name SET NOT NULL,
    ALTER COLUMN first_name SET NOT NULL,
    ALTER COLUMN middle_name SET NOT NULL,
    DROP COLUMN full_name,
    ADD CONSTRAINT uq_property_owner_fio UNIQUE (last_name, first_name, middle_name);

ALTER TABLE PROPERTY_OWNER RENAME TO new_property_owner;

-- 3. Змінюємо PROPERTY -> new_property
ALTER TABLE PROPERTY
    ADD COLUMN city_id INT,
    ADD COLUMN street VARCHAR(80),
    ADD COLUMN building_number VARCHAR(15),
    ADD COLUMN apartment_number VARCHAR(15);

INSERT INTO city (city_name)
SELECT DISTINCT regexp_replace(trim(split_part(adress, ',', 1)), '^м\.\s*', '')
FROM PROPERTY
WHERE regexp_replace(trim(split_part(adress, ',', 1)), '^м\.\s*', '') <> ''
ON CONFLICT (city_name) DO NOTHING;

UPDATE PROPERTY p
SET
    city_id = c.city_id,
    street = trim(split_part(p.adress, ',', 2)),
    building_number = trim(split_part(p.adress, ',', 3)),
    apartment_number = NULLIF(trim(split_part(p.adress, ',', 4)), '')
FROM city c
WHERE regexp_replace(trim(split_part(p.adress, ',', 1)), '^м\.\s*', '') = c.city_name;

ALTER TABLE PROPERTY
    ALTER COLUMN city_id SET NOT NULL,
    ALTER COLUMN street SET NOT NULL,
    ALTER COLUMN building_number SET NOT NULL,
    DROP COLUMN adress,
    ADD CONSTRAINT fk_property_city FOREIGN KEY (city_id) REFERENCES city(city_id),
    ADD CONSTRAINT uq_property_address UNIQUE (city_id, street, building_number, apartment_number);

ALTER TABLE PROPERTY RENAME TO new_property;

-- 4. Змінюємо TENANT -> new_tenant
ALTER TABLE TENANT
    ADD COLUMN last_name VARCHAR(40),
    ADD COLUMN first_name VARCHAR(40),
    ADD COLUMN middle_name VARCHAR(40);

UPDATE TENANT
SET
    last_name = split_part(trim(full_name), ' ', 1),
    first_name = split_part(trim(full_name), ' ', 2),
    middle_name = split_part(trim(full_name), ' ', 3);

ALTER TABLE TENANT
    ALTER COLUMN last_name SET NOT NULL,
    ALTER COLUMN first_name SET NOT NULL,
    ALTER COLUMN middle_name SET NOT NULL,
    DROP COLUMN full_name,
    ADD CONSTRAINT uq_tenant_fio UNIQUE (last_name, first_name, middle_name);

ALTER TABLE TENANT RENAME TO new_tenant;

-- 5. Змінюємо REALTOR -> new_realtor
ALTER TABLE REALTOR
    ADD COLUMN last_name VARCHAR(40),
    ADD COLUMN first_name VARCHAR(40),
    ADD COLUMN middle_name VARCHAR(40);

UPDATE REALTOR
SET
    last_name = split_part(trim(full_name), ' ', 1),
    first_name = split_part(trim(full_name), ' ', 2),
    middle_name = split_part(trim(full_name), ' ', 3);

ALTER TABLE REALTOR
    ALTER COLUMN last_name SET NOT NULL,
    ALTER COLUMN first_name SET NOT NULL,
    ALTER COLUMN middle_name SET NOT NULL,
    DROP COLUMN full_name,
    ADD CONSTRAINT uq_realtor_fio UNIQUE (last_name, first_name, middle_name);

ALTER TABLE REALTOR RENAME TO new_realtor;

-- 6. Змінюємо APPLICATION -> new_application
ALTER TABLE APPLICATION
    ADD COLUMN status_id INT;

UPDATE APPLICATION a
SET status_id = s.status_id
FROM application_status s
WHERE a.status = s.status_name;

ALTER TABLE APPLICATION
    ALTER COLUMN status_id SET NOT NULL,
    DROP COLUMN status,
    ADD CONSTRAINT fk_application_status FOREIGN KEY (status_id) REFERENCES application_status(status_id);

ALTER TABLE APPLICATION RENAME TO new_application;

-- 7. Змінюємо LEASE_AGREEMENT -> new_lease_agreement
ALTER TABLE LEASE_AGREEMENT
    DROP CONSTRAINT IF EXISTS ch_ex_rieltor,
    DROP COLUMN agency_commission;

ALTER TABLE LEASE_AGREEMENT RENAME TO new_lease_agreement;

COMMIT;

---------------------------------------------------------------------
-- ПЕРЕВІРКА РОБОТИ ТА ОБЧИСЛЕННЯ КОМІСІЇ (VIEW)
---------------------------------------------------------------------

CREATE OR REPLACE VIEW v_lease_details AS
SELECT
    la.lease_id,
    c.city_name || ', ' || p.street || ', буд. ' || p.building_number || COALESCE(', кв. ' || p.apartment_number, '') AS full_address,
    t.last_name || ' ' || t.first_name AS tenant_name,
    r.last_name || ' ' || r.first_name AS realtor_name,
    la.start_date,
    la.end_date,
    la.rental_amount,
    ROUND(la.rental_amount * r.commission_rate / 100.0, 2) AS calculated_commission
FROM new_lease_agreement la
JOIN new_property p ON la.property_id = p.property_id
JOIN city c ON p.city_id = c.city_id
JOIN new_tenant t ON la.tenant_id = t.tenant_id
LEFT JOIN new_realtor r ON la.realtor_id = r.realtor_id;

SELECT * FROM v_lease_details;
