        int faculty_id PK
        string name UK
    }
    STUDENT_GROUP {
        int group_id PK
        int faculty_id FK
        string name UK
    }
    STUDENT {
        int student_id PK
        int group_id FK
        string full_name
    }
    SECURITY_EMPLOYEE {
        int employee_id PK
        string full_name
        string position
        string phone UK
    }
    INCIDENT_TYPE {
        int type_id PK
        string name UK
    }
    INCIDENT_STATUS {
        int status_id PK
        string name UK
    }
    PARTICIPANT_ROLE {
        int role_id PK
        string name UK
    }
    VISIT {
        int visit_id PK
        int student_id FK
        string category
        datetime started_at
        datetime ended_at
    }
    INCIDENT {
        int incident_id PK
        int visit_id FK
        int type_id FK
        int employee_id FK
